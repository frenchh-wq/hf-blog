# --- Claude (research / strategy generation / self-improvement) ---
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5

# --- Market data / execution ---
EXCHANGE=binance            # any ccxt id: binance, bybit, kraken, ...
SYMBOL=BTC/USDT
TIMEFRAME=1h
EXCHANGE_API_KEY=
EXCHANGE_API_SECRET=

# --- Mode ---  paper | live
MODE=paper
# Live trading needs BOTH MODE=live and this exact phrase:
LIVE_CONFIRM=
PAPER_STARTING_BALANCE=10000

# --- Risk rules ---
RISK_PER_TRADE=0.02         # 2% of equity at risk per trade
DAILY_LOSS_LIMIT=0.05       # 5%
MAX_DRAWDOWN=0.15           # 15%
MIN_CONFIDENCE=1.5
FEE_RATE=0.001
SLIPPAGE=0.0005

# --- Notifications (optional) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DISCORD_WEBHOOK_URL=

DB_PATH=trading.db
DASHBOARD_PORT=8050
